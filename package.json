{
  "name": "scraploop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:browser": "playwright test",
    "ml:prepare": ".venv/bin/python ml/prepare.py",
    "ml:train": ".venv/bin/python ml/train.py",
    "test:ml": ".venv/bin/python -m unittest discover -s ml -p 'test_*.py'",
    "ml:evaluate": ".venv/bin/python ml/evaluate.py",
    "assets:vendor": "node scripts/copy-viewer.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0"
  }
}
